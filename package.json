{
  "name": "barcelona-next-rain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "predev": "node scripts/signals-build.mjs && node scripts/copy-data.mjs",
    "prebuild": "node scripts/signals-build.mjs && node scripts/copy-data.mjs",
    "prepreview": "node scripts/signals-build.mjs && node scripts/copy-data.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "qa": "node scripts/qa.mjs",
    "qa:urls": "node scripts/qa.mjs --urls",
    "preqa": "node scripts/signals-build.mjs",
    "signals": "node scripts/signals.mjs",
    "signals:build": "node scripts/signals-build.mjs",
    "signals:check": "node --test scripts/signals.test.mjs",
    "pulse": "node scripts/pulse.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/outfit": "^5.2.8",
    "maplibre-gl": "^5.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3"
  }
}
